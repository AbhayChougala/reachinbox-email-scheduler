# Public origin (same origin is recommended in production)
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
PUBLIC_ORIGIN=http://localhost:4000
TRUST_PROXY=false
# Tunnel hostname only, without https://. Leave empty for localhost-only Vite.
DEV_PUBLIC_HOST=

# Production Compose interpolation (not read by the application directly)
APP_DOMAIN=mail.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Infrastructure
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:15432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox-emails-v1

# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# Exactly 32 bytes, base64 encoded: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Google Cloud OAuth web application
GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Slack app with incoming-webhook scope
SLACK_CLIENT_ID=replace
SLACK_CLIENT_SECRET=replace
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback

# Worker and scheduler controls
WORKER_CONCURRENCY=10
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=100
SMTP_MAX_ATTEMPTS=3
DEFAULT_SENDER_MIN_INTERVAL_MS=1000
DEFAULT_SENDER_HOURLY_LIMIT=100
MAX_CAMPAIGN_RECIPIENTS=5000

# Comma-separated Google-account emails allowed to view /admin/queues
ADMIN_EMAILS=reviewer@example.com

# Provisioning script input; creates/updates an owner and two durable Ethereal senders
PROVISION_OWNER_EMAIL=reviewer@example.com
PROVISION_OWNER_NAME=Assignment Reviewer
